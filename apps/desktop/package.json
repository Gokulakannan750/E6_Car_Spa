{
  "name": "@carspa/desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "renderer/dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "clean": "rm -rf renderer/dist-renderer renderer/dist-electron",
    "typecheck": "tsc --noEmit",
    "electron:dev": "vite",
    "electron:build": "vite build",
    "electron:package": "electron-builder --win"
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "date-fns": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "recharts": "^2.14.0",
    "tailwind-merge": "^2.5.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.5.4",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "postcss": "^8.4.0",
    "react-router": "^6.30.6",
    "react-router-dom": "^6.30.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0"
  },
  "build": {
    "appId": "com.carspapro.app",
    "productName": "Car Spa Management",
    "directories": {
      "output": "release"
    },
    "files": [
      "renderer/dist-renderer/**/*",
      "renderer/dist-electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}

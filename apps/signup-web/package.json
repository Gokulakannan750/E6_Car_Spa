{
  "name": "signup-web",
  "version": "1.0.0",
  "private": true,
  "description": "Trovo public sign-up website: businesses choose a plan, user licences and add-ons, pay or start the trial, and get their codes.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --project=mocked",
    "test:preflight": "node scripts/check-staging.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.0",
    "@tanstack/react-query": "^5.59.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.9"
  }
}

<?xml version="1.0" encoding="utf-8"?>
<!-- RELEASE / PROFILE BUILDS: HTTPS only. No development hosts or cleartext HTTP.
     Development cleartext hosts live in src/debug/res/xml/network_security_config.xml.
     If a release build must reach an HTTP-only LAN server, add that host here deliberately
     (and plan TLS — see docs/PRODUCTION_CONFIGURATION.md). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

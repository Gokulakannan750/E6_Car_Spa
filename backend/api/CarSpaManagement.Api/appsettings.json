{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=CarSpaManagement;Username=postgres;Password=CHANGE_ME"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/carspa-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Cors": {
    "AllowedOrigins": [
      "app://carspa"
    ]
  },
  "Jwt": {
    "Issuer": "CarSpaManagement",
    "Audience": "CarSpaManagementClients",
    "ExpirationMinutes": 1440
  },
  "PublicInvoiceBaseUrl": "",
  "JobCard": {
    "Prefix": "JC"
  },
  "DefaultBusinessProfile": {
    "BusinessName": "",
    "AddressLine1": "",
    "AddressLine2": null,
    "City": "",
    "State": "",
    "PostalCode": "",
    "Phone": "",
    "Email": "",
    "Gstin": null,
    "LogoPath": null,
    "Tagline": null,
    "InvoicePrefix": "INV"
  },
  "AllowedHosts": "*"
}

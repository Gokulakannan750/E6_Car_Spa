{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=E6CarSpaNew;Username=postgres;Password=CHANGE_ME"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/carspa-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "app://carspa"
    ]
  },
  "Jwt": {
    "Issuer": "E6CarSpa",
    "Audience": "E6CarSpaDesktop",
    "ExpirationMinutes": 1440
  },
  "PublicInvoiceBaseUrl": "https://invoice.e6carspa.com",
  "JobCard": {
    "Prefix": "JC"
  },
  "DefaultBusinessProfile": {
    "BusinessName": "E6 Car Spa",
    "AddressLine1": "36, Geetha Nagar Main Road",
    "AddressLine2": "Behind Sakthi Mahal, Perundurai Road",
    "City": "Erode",
    "State": "Tamil Nadu",
    "PostalCode": "638011",
    "Phone": "9578749449",
    "Email": "e6carspaerd@gmail.com",
    "Gstin": null,
    "LogoPath": "/uploads/logos/e6-logo.png",
    "InvoicePrefix": "INV"
  },
  "AllowedHosts": "*"
}

{
 "name": "car-spa-pro",
 "version": "1.0.0",
 "private": true,
 "workspaces": ["apps/*"],
 "scripts": {
 "dev": "pnpm --filter @carspa/desktop dev",
 "build": "pnpm --filter @carspa/desktop build",
 "preview": "pnpm --filter @carspa/desktop preview",
 "clean": "pnpm --filter @carspa/desktop clean",
 "backend": "pnpm --filter @carspa/backend dev",
 "migrate": "pnpm --filter @carspa/backend migrate",
 "db:seed": "pnpm --filter @carspa/backend db:seed",
 "dev:all": "concurrently \"pnpm dev\" \"pnpm backend\"",
 "lint": "eslint . --ext .ts,.tsx",
 "format": "prettier --write .",
 "typecheck": "tsc --noEmit",
 "prepare": "husky install"
 },
 "dependencies": {
 "react-router-dom": "6.30.6",
 "react-router": "6.30.6"
 },
 "devDependencies": {
 "@types/react": "^19.0.0",
 "@types/react-dom": "^19.0.0",
 "@types/node": "^22.0.0",
 "concurrently": "^9.0.0",
 "husky": "^9.0.0",
 "prettier": "^3.0.0",
 "turbo": "^2.0.0",
 "typescript": "^5.6.0"
 }
}

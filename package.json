{
 "name": "car-spa-pro",
 "version": "1.0.0",
 "private": true,
 "workspaces": ["apps/*"],
 "scripts": {
 "dev": "pnpm --filter @carspa/desktop dev",
 "build": "pnpm --filter @carspa/desktop build",
 "preview": "pnpm --filter @carspa/desktop preview",
 "clean": "pnpm --filter @carspa/desktop clean",
 "backend": "dotnet run --project backend/api/CarSpaManagement.Api --launch-profile http",
 "migrate": "dotnet run --project backend/api/CarSpaManagement.Api -- platform migrate",
 "dev:all": "concurrently \"pnpm dev\" \"pnpm backend\"",
 "lint": "pnpm --dir apps/desktop/renderer lint",
 "format": "prettier --write .",
 "typecheck": "pnpm --dir apps/desktop typecheck && pnpm --dir apps/platform-admin type-check",
 "test": "pnpm test:desktop && pnpm test:admin && pnpm test:backend",
 "test:desktop": "pnpm --dir apps/desktop test",
 "test:admin": "pnpm --dir apps/platform-admin test",
 "test:backend": "dotnet test backend/tests/CarSpaManagement.Api.Tests",
 "test:backend:integration": "pwsh -NoProfile -File scripts/test-backend-integration.ps1",
 "test:android": "cd apps/android && flutter test",
 "prepare": "husky install"
 },
 "dependencies": {
 "react-router-dom": "6.30.6",
 "react-router": "6.30.6"
 },
 "devDependencies": {
 "@types/react": "^19.0.0",
 "@types/react-dom": "^19.0.0",
 "@types/node": "^22.0.0",
 "concurrently": "^9.0.0",
 "husky": "^9.0.0",
 "prettier": "^3.0.0",
 "turbo": "^2.0.0",
 "typescript": "^5.6.0"
 }
}
